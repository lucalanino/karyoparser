{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(air:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(git grep:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(R:*)",
      "Bash(rm:*)",
      "Bash(Rscript:*)",
      "Bash(sed:*)",
      "Skill(update-config)"
    ],
    "deny": [
      "Read(.Renviron)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "air format .",
            "statusMessage": "air format"
          }
        ]
      }
    ]
  }
}
